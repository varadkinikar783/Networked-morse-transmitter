        "name": "function 2",
        "func": "const nextOffset = flow.get(\"telegram_offset\");\n\nlet telegramUrl = \"https://api.telegram.org/botTOKEN/getUpdates\";\n\nif (nextOffset !== undefined) {\n    telegramUrl += \"?offset=\" + nextOffset;\n}\n\nmsg.url = telegramUrl;\n \nreturn msg;",
