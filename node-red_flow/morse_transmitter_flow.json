    {
        "id": "d120518465c3c9c1",
        "type": "function",
        "z": "2ba1f47195931082",
        "name": "function 1",
        "func": "const telegramResponse = msg.payload;\nconst updates = telegramResponse.result;\n\nif (!updates || updates.length === 0) {\n    return null;\n}\n\nlet nextOffset = flow.get(\"telegram_offset\");\n\nfor (const update of updates) {\n\n    // Telegram update ID\n    const updateId = update.update_id;\n\n    // Update the offset for the next Telegram request\n    if (nextOffset === undefined || updateId >= nextOffset) {\n        nextOffset = updateId + 1;\n    }\n\n    // Ignore updates that are not text messages\n    if (!update.message || !update.message.text) {\n        continue;\n    }\n\n    const telegramMessage = update.message;\n\n    // Send one clean message for each Telegram update\n    node.send({\n        payload: {\n            update_id: updateId,\n            message_id: telegramMessage.message_id,\n            sender_id: telegramMessage.from.id,\n            message: telegramMessage.text\n        }\n    });\n}\n\n// Save the offset for the next request\nflow.set(\"telegram_offset\", nextOffset);\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
